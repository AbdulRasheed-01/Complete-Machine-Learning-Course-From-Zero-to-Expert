plt.title('Validation Loss by Layer Width')
plt.legend()
plt.grid(True, alpha=0.3)

plt.subplot(1, 2, 2)
final_val_loss = [width_histories[w].history['val_loss'][-1] for w in widths]
plt.plot(widths, final_val_loss, 'bo-', linewidth=2, markersize=8)
plt.xlabel('Layer Width')
plt.ylabel('Final Validation Loss')
plt.title('Performance vs Width')
plt.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('width_comparison.png')
plt.show()
print("✅ Width comparison saved as 'width_comparison.png'")

# 4. Activation Function Comparison
print("\n4. ACTIVATION FUNCTION COMPARISON:")

activations = ['relu', 'tanh', 'sigmoid', 'elu']
activation_histories = {}

for activation in activations:
    print(f"\nTraining model with {activation} activation...")
    model = create_deep_model(depth=5, width=64, activation=activation)
    
    model.compile(
        optimizer='adam',
        loss='mse',
        metrics=['mae']
    )
    
    history = model.fit(
        X_train_scaled, y_train,
        validation_data=(X_test_scaled, y_test),
        epochs=50,
        batch_size=32,
        verbose=0
    )
    
    activation_histories[activation] = history
    
    test_loss, test_mae = model.evaluate(X_test_scaled, y_test, verbose=0)
    print(f"  Test MAE: ${test_mae:.4f}")

plt.figure(figsize=(12, 5))

for activation in activations:
    plt.plot(activation_histories[activation].history['val_loss'], 
             label=activation.capitalize())

plt.xlabel('Epoch')
plt.ylabel('Validation Loss')
plt.title('Activation Function Comparison')
plt.legend()
plt.grid(True, alpha=0.3)
plt.savefig('activation_comparison.png')
plt.show()
print("✅ Activation comparison saved as 'activation_comparison.png'")

# 5. Residual Connections (Skip Connections)
print("\n5. RESIDUAL CONNECTIONS:")

def create_residual_block(x, units, dropout_rate=0.3):
    """Create a residual block with skip connection"""
    shortcut = x
    
    # Main path
    x = layers.Dense(units, activation='relu')(x)
    x = layers.BatchNormalization()(x)
    x = layers.Dropout(dropout_rate)(x)
    x = layers.Dense(units, activation='relu')(x)
    x = layers.BatchNormalization()(x)
    
    # Add skip connection
    if shortcut.shape[-1] != units:
        shortcut = layers.Dense(units)(shortcut)
    
    x = layers.Add()([x, shortcut])
    x = layers.Activation('relu')(x)
    
    return x

# Build model with residual connections
inputs = layers.Input(shape=(8,))
x = layers.Dense(64, activation='relu')(inputs)

# Add residual blocks
x = create_residual_block(x, 64)
x = create_residual_block(x, 64)
x = create_residual_block(x, 64)

x = layers.Dense(32, activation='relu')(x)
outputs = layers.Dense(1)(x)

residual_model = keras.Model(inputs, outputs)

residual_model.compile(
    optimizer='adam',
    loss='mse',
    metrics=['mae']
)

print("Residual model summary:")
residual_model.summary()

# Train residual model
history_residual = residual_model.fit(
    X_train_scaled, y_train,
    validation_data=(X_test_scaled, y_test),
    epochs=50,
    batch_size=32,
    verbose=0
)

# Compare with regular deep model
