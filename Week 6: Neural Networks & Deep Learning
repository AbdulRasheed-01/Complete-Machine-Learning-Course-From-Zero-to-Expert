plt.figure(figsize=(12, 5))

plt.subplot(1, 2, 1)
plt.plot(history_regular.history['val_loss'], label='Regular Network')
plt.plot(history_residual.history['val_loss'], label='Residual Network')
plt.xlabel('Epoch')
plt.ylabel('Validation Loss')
plt.title('Regular vs Residual Networks')
plt.legend()
plt.grid(True, alpha=0.3)

plt.subplot(1, 2, 2)
test_mae_regular = regular_model.evaluate(X_test_scaled, y_test, verbose=0)[1]
test_mae_residual = residual_model.evaluate(X_test_scaled, y_test, verbose=0)[1]

