plt.subplot(1, 2, 2)
plt.plot(time_tracker.times)
plt.xlabel('Epoch')
plt.ylabel('Time (seconds)')
plt.title('Time per Epoch')
plt.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('custom_callbacks.png')
plt.show()
print("✅ Custom callback results saved as 'custom_callbacks.png'")

# 4. Custom Training Loop with GradientTape
print("\n4. CUSTOM TRAINING LOOP WITH GRADIENTTAPE:")

# Create a simple model
class SimpleModel(keras.Model):
    def __init__(self):
        super().__init__()
        self.dense1 = layers.Dense(64, activation='relu')
        self.dense2 = layers.Dense(32, activation='relu')
        self.dense3 = layers.Dense(5, activation='softmax')
    
    def call(self, inputs):
        x = self.dense1(inputs)
        x = self.dense2(x)
        return self.dense3(x)

# Initialize model, optimizer, loss function
custom_loop_model = SimpleModel()
optimizer = keras.optimizers.Adam(learning_rate=0.001)
loss_fn = keras.losses.CategoricalCrossentropy()
train_acc_metric = keras.metrics.CategoricalAccuracy()
val_acc_metric = keras.metrics.CategoricalAccuracy()

# Convert to tf.data.Dataset for efficient batching
batch_size = 32
train_dataset = tf.data.Dataset.from_tensor_slices((X_train_scaled, y_train))
train_dataset = train_dataset.shuffle(buffer_size=1024).batch(batch_size)

val_dataset = tf.data.Dataset.from_tensor_slices((X_test_scaled, y_test))
val_dataset = val_dataset.batch(batch_size)

# Custom training loop
epochs = 20
train_losses = []
val_losses = []
train_accs = []
val_accs = []

for epoch in range(epochs):
    print(f"\nEpoch {epoch+1}/{epochs}")
    
    # Training
    train_loss = 0
    num_batches = 0
    
    for x_batch, y_batch in train_dataset:
        with tf.GradientTape() as tape:
            logits = custom_loop_model(x_batch, training=True)
            loss_value = loss_fn(y_batch, logits)
        
        grads = tape.gradient(loss_value, custom_loop_model.trainable_weights)
        optimizer.apply_gradients(zip(grads, custom_loop_model.trainable_weights))
        
        train_loss += loss_value.numpy()
        train_acc_metric.update_state(y_batch, logits)
        num_batches += 1
    
    train_loss /= num_batches
    train_acc = train_acc_metric.result().numpy()
    train_acc_metric.reset_states()
    
    # Validation
    val_loss = 0
    num_val_batches = 0
    
    for x_batch, y_batch in val_dataset:
        logits = custom_loop_model(x_batch, training=False)
        loss_value = loss_fn(y_batch, logits)
        val_loss += loss_value.numpy()
        val_acc_metric.update_state(y_batch, logits)
        num_val_batches += 1
    
    val_loss /= num_val_batches
    val_acc = val_acc_metric.result().numpy()
    val_acc_metric.reset_states()
    
    train_losses.append(train_loss)
    val_losses.append(val_loss)
    train_accs.append(train_acc)
    val_accs.append(val_acc)
    
    print(f"  Train loss: {train_loss:.4f}, Train acc: {train_acc:.4f}")
    print(f"  Val loss: {val_loss:.4f}, Val acc: {val_acc:.4f}")

# Plot custom training results
plt.figure(figsize=(12, 4))

plt.subplot(1, 2, 1)
plt.plot(train_losses, label='Train Loss')
plt.plot(val_losses, label='Val Loss')
plt.xlabel('Epoch')
plt.ylabel('Loss')
plt.title('Custom Training Loop - Loss')
plt.legend()
plt.grid(True, alpha=0.3)

plt.subplot(1, 2, 2)
plt.plot(train_accs, label='Train Accuracy')
plt.plot(val_accs, label='Val Accuracy')
plt.xlabel('Epoch')
plt.ylabel('Accuracy')
plt.title('Custom Training Loop - Accuracy')
plt.legend()
plt.grid(True, alpha=0.3)

