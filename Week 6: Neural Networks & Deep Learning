# 2. Neural Network Class
print("\n2. IMPLEMENTING NEURAL NETWORK CLASS:")

class NeuralNetwork:
    """Neural network implementation from scratch"""
    
    def __init__(self, layer_sizes, activations='relu', seed=42):
        """
        Initialize neural network
        
        Args:
            layer_sizes: List of layer sizes [input_size, hidden1, hidden2, ..., output_size]
            activations: Activation function for hidden layers ('relu', 'sigmoid', 'tanh')
            seed: Random seed for reproducibility
        """
        np.random.seed(seed)
        self.layer_sizes = layer_sizes
        self.num_layers = len(layer_sizes)
        
        # Initialize activation functions
        if activations == 'relu':
            self.activation = ActivationFunctions.relu
            self.activation_derivative = ActivationFunctions.relu_derivative
        elif activations == 'sigmoid':
            self.activation = ActivationFunctions.sigmoid
            self.activation_derivative = ActivationFunctions.sigmoid_derivative
        elif activations == 'tanh':
            self.activation = ActivationFunctions.tanh
            self.activation_derivative = ActivationFunctions.tanh_derivative
        else:
            raise ValueError(f"Unknown activation: {activations}")
        
        # Initialize weights and biases
        self.weights = []
        self.biases = []
        
        for i in range(self.num_layers - 1):
            # He initialization for ReLU, Xavier for others
            if activations == 'relu':
                scale = np.sqrt(2.0 / layer_sizes[i])
            else:
                scale = np.sqrt(1.0 / layer_sizes[i])
                
            w = np.random.randn(layer_sizes[i], layer_sizes[i + 1]) * scale
            b = np.zeros((1, layer_sizes[i + 1]))
            
            self.weights.append(w)
            self.biases.append(b)
        
        # For storing intermediate values during forward/backward pass
        self.cache = {}
        
        print(f"Network initialized with layers: {layer_sizes}")
        print(f"Total parameters: {self._count_parameters()}")
    
    def _count_parameters(self):
        """Count total number of trainable parameters"""
        total = 0
        for w, b in zip(self.weights, self.biases):
            total += w.size + b.size
        return total
    
    def forward(self, X):
        """Forward propagation"""
        self.cache['A0'] = X
        
        for i in range(self.num_layers - 2):
            Z = np.dot(self.cache[f'A{i}'], self.weights[i]) + self.biases[i]
            self.cache[f'Z{i+1}'] = Z
            self.cache[f'A{i+1}'] = self.activation(Z)
        
        # Output layer (using linear activation for regression, softmax for classification)
        i = self.num_layers - 2
        Z = np.dot(self.cache[f'A{i}'], self.weights[i]) + self.biases[i]
        self.cache[f'Z{i+1}'] = Z
        
        # For classification with multiple outputs, use softmax
        if self.layer_sizes[-1] > 1:
            self.cache[f'A{i+1}'] = ActivationFunctions.softmax(Z)
        else:
            self.cache[f'A{i+1}'] = Z  # Linear for regression
        
        return self.cache[f'A{i+1}']
    
    def compute_loss(self, y_true, y_pred):
        """Compute loss (MSE for regression, cross-entropy for classification)"""
        if self.layer_sizes[-1] == 1:
            # Regression - MSE
            loss = np.mean((y_true - y_pred) ** 2)
        else:
            # Classification - cross-entropy
            m = y_true.shape[0]
            loss = -np.sum(y_true * np.log(y_pred + 1e-8)) / m
        
        return loss
    
    def backward(self, y_true, learning_rate=0.01):
        """Backward propagation"""
        m = y_true.shape[0]
        L = self.num_layers - 1  # Last layer index
        
        # Output layer gradient
        if self.layer_sizes[-1] == 1:
            # Regression
            dZ = self.cache[f'A{L}'] - y_true.reshape(-1, 1)
        else:
            # Classification with softmax + cross-entropy
            dZ = self.cache[f'A{L}'] - y_true
        
        # Backpropagate through layers
        for i in range(L - 1, -1, -1):
            A_prev = self.cache[f'A{i}']
            
            dW = np.dot(A_prev.T, dZ) / m
            db = np.sum(dZ, axis=0, keepdims=True) / m
            
            if i > 0:
                dA_prev = np.dot(dZ, self.weights[i].T)
                dZ = dA_prev * self.activation_derivative(self.cache[f'Z{i}'])
            
            # Update parameters
            self.weights[i] -= learning_rate * dW
            self.biases[i] -= learning_rate * db
    
    def train(self, X, y, X_val=None, y_val=None, epochs=1000, learning_rate=0.01, 
              batch_size=32, verbose=True):
        """Train the neural network"""
        n_samples = X.shape[0]
        history = {'loss': [], 'val_loss': []}
        
        for epoch in range(epochs):
            # Shuffle data
            indices = np.random.permutation(n_samples)
            X_shuffled = X[indices]
            y_shuffled = y[indices]
            
            # Mini-batch training
            for i in range(0, n_samples, batch_size):
                X_batch = X_shuffled[i:i+batch_size]
                y_batch = y_shuffled[i:i+batch_size]
                
                # Forward pass
                y_pred = self.forward(X_batch)
                
                # Backward pass
                self.backward(y_batch, learning_rate)
            
            # Compute loss after epoch
            y_pred_train = self.forward(X)
            train_loss = self.compute_loss(y, y_pred_train)
            history['loss'].append(train_loss)
            
            if X_val is not None:
                y_pred_val = self.forward(X_val)
                val_loss = self.compute_loss(y_val, y_pred_val)
                history['val_loss'].append(val_loss)
            
            if verbose and (epoch + 1) % 100 == 0:
                print(f"Epoch {epoch+1}/{epochs} - loss: {train_loss:.4f}")
        
        return history
    
    def predict(self, X):
        """Make predictions"""
        return self.forward(X)

