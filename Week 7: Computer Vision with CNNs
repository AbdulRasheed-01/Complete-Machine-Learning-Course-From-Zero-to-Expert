            elif class_name == 'square':
                size = np.random.randint(15, 25)
                x1 = center_x - size//2
                y1 = center_y - size//2
                x2 = center_x + size//2
                y2 = center_y + size//2
                cv2.rectangle(img, (x1, y1), (x2, y2), color.tolist(), -1)
                
            elif class_name == 'triangle':
                size = np.random.randint(15, 25)
                points = np.array([
                    [center_x, center_y - size],
                    [center_x - size, center_y + size//2],
                    [center_x + size, center_y + size//2]
                ], np.int32)
                cv2.fillPoly(img, [points], color.tolist())
                
            elif class_name == 'rectangle':
                width = np.random.randint(15, 30)
                height = np.random.randint(10, 20)
                x1 = center_x - width//2
