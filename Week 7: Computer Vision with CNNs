# transfer_learning.py
"""
Transfer learning with pre-trained models
"""

import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers, models
from tensorflow.keras.applications import VGG16, ResNet50, InceptionV3
from tensorflow.keras.applications.vgg16 import preprocess_input as vgg_preprocess
from sklearn.metrics import classification_report
from sklearn.model_selection import train_test_split
import warnings
warnings.filterwarnings('ignore')

print("="*60)
print("TRANSFER LEARNING")
print("="*60)

# 1. Load pre-trained model
print("\n1. LOADING PRE-TRAINED MODEL:")

# Load VGG16 without top layers
base_model = VGG16(
    weights='imagenet',
    include_top=False,
    input_shape=(32, 32, 3)  # CIFAR-10 size
)

print("VGG16 base model loaded")
base_model.summary()

# 2. Create custom model on top
print("\n2. BUILDING CUSTOM CLASSIFIER:")

# Freeze base model layers
base_model.trainable = False

# Create new model
transfer_model = models.Sequential([
    base_model,
    layers.GlobalAveragePooling2D(),
    layers.Dense(256, activation='relu'),
    layers.Dropout(0.5),
    layers.Dense(10, activation='softmax')
])

print("Transfer learning model summary:")
transfer_model.summary()

# 3. Load and prepare data
print("\n3. PREPARING DATA:")

(X_train, y_train), (X_test, y_test) = keras.datasets.cifar10.load_data()

# Normalize and preprocess
X_train = vgg_preprocess(X_train.astype('float32'))
X_test = vgg_preprocess(X_test.astype('float32'))

# Use subset for faster training
X_train_small = X_train[:5000]
y_train_small = keras.utils.to_categorical(y_train[:5000], 10)
X_val = X_train[5000:7000]
y_val = keras.utils.to_categorical(y_train[5000:7000], 10)
X_test_small = X_test[:1000]
y_test_small = keras.utils.to_categorical(y_test[:1000], 10)

print(f"Training set: {X_train_small.shape}")
print(f"Validation set: {X_val.shape}")
print(f"Test set: {X_test_small.shape}")

# 4. Train the model
print("\n4. TRAINING THE TRANSFER LEARNING MODEL:")

transfer_model.compile(
    optimizer=keras.optimizers.Adam(learning_rate=0.001),
    loss='categorical_crossentropy',
    metrics=['accuracy']
)

history = transfer_model.fit(
    X_train_small, y_train_small,
    batch_size=32,
    epochs=20,
    validation_data=(X_val, y_val),
    verbose=1
)

# 5. Evaluate
print("\n5. EVALUATING THE MODEL:")

test_loss, test_acc = transfer_model.evaluate(X_test_small, y_test_small, verbose=0)
print(f"Test Accuracy: {test_acc:.4f}")

# 6. Fine-tuning
print("\n6. FINE-TUNING THE MODEL:")

# Unfreeze the last few layers of base model
base_model.trainable = True

# Freeze early layers
for layer in base_model.layers[:15]:
    layer.trainable = False

# Recompile with lower learning rate
transfer_model.compile(
    optimizer=keras.optimizers.Adam(learning_rate=0.0001),
    loss='categorical_crossentropy',
    metrics=['accuracy']
)

print("Fine-tuning model...")
fine_tune_history = transfer_model.fit(
    X_train_small, y_train_small,
    batch_size=32,
    epochs=10,
    validation_data=(X_val, y_val),
    verbose=1
)

# 7. Compare different pre-trained models
print("\n7. COMPARING DIFFERENT PRE-TRAINED MODELS:")

models_to_try = {
    'VGG16': VGG16,
    'ResNet50': ResNet50,
    'InceptionV3': InceptionV3
}

results = {}

for name, model_class in models_to_try.items():
    print(f"\nTrying {name}...")
    
    try:
        # Load base model
        base = model_class(
            weights='imagenet',
            include_top=False,
            input_shape=(32, 32, 3)
        )
        base.trainable = False
        
        # Build model
        model = models.Sequential([
            base,
            layers.GlobalAveragePooling2D(),
            layers.Dense(128, activation='relu'),
            layers.Dropout(0.5),
            layers.Dense(10, activation='softmax')
        ])
        
        # Compile
        model.compile(
            optimizer='adam',
            loss='categorical_crossentropy',
            metrics=['accuracy']
        )
        
        # Train briefly
        history = model.fit(
            X_train_small, y_train_small,
            batch_size=32,
            epochs=5,
            validation_data=(X_val, y_val),
            verbose=0
        )
        
        val_acc = history.history['val_accuracy'][-1]
        results[name] = val_acc
        print(f"  Validation Accuracy: {val_acc:.4f}")
        
    except Exception as e:
        print(f"  Error with {name}: {e}")

# Plot comparison
plt.figure(figsize=(10, 6))
plt.bar(results.keys(), results.values(), edgecolor='black')
plt.ylabel('Validation Accuracy')
plt.title('Transfer Learning - Model Comparison')
plt.grid(True, alpha=0.3, axis='y')
plt.savefig('transfer_learning_comparison.png')
plt.show()
print("✅ Transfer learning comparison saved as 'transfer_learning_comparison.png'")

