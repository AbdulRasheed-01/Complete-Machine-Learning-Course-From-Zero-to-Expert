# 3. Simple CNN class
print("\n3. SIMPLE CNN CLASS:")

class SimpleCNN:
    """A simple CNN for digit classification"""
    
    def __init__(self):
        # Initialize weights (simplified - just for demonstration)
        self.conv1_kernel = np.random.randn(3, 3) * 0.1
        self.fc_weights = np.random.randn(36, 10) * 0.1  # 6x6 after pooling * 1 channel
        self.fc_bias = np.zeros(10)
    
    def forward(self, X):
        """
        Forward pass:
        Input (28x28) -> Conv (3x3) -> ReLU -> MaxPool (2x2) -> Flatten -> FC
        """
        batch_size = X.shape[0]
        conv_outputs = []
        
        for i in range(batch_size):
            # Conv layer
            conv = conv2d_single(X[i], self.conv1_kernel)
            # ReLU
            relu = np.maximum(conv, 0)
            # Max pooling
            pooled = max_pool2d(relu, pool_size=2, stride=2)
            conv_outputs.append(pooled.flatten())
        
        # Flatten and FC layer
        flattened = np.array(conv_outputs)
        output = np.dot(flattened, self.fc_weights) + self.fc_bias
        
        # Softmax
        exp_output = np.exp(output - np.max(output, axis=1, keepdims=True))
        probs = exp_output / np.sum(exp_output, axis=1, keepdims=True)
        
        return probs
    
    def predict(self, X):
        probs = self.forward(X)
        return np.argmax(probs, axis=1)

