# 2. Implement max pooling
print("\n2. MAX POOLING FROM SCRATCH:")

def max_pool2d(input_matrix, pool_size=2, stride=2):
    """
    Perform 2D max pooling
    """
    h, w = input_matrix.shape
    out_h = (h - pool_size) // stride + 1
    out_w = (w - pool_size) // stride + 1
    
    output = np.zeros((out_h, out_w))
    
    for i in range(0, out_h):
        for j in range(0, out_w):
            i_start = i * stride
            i_end = i_start + pool_size
            j_start = j * stride
            j_end = j_start + pool_size
            
            patch = input_matrix[i_start:i_end, j_start:j_end]
            output[i, j] = np.max(patch)
    
    return output

