"""
Object detection using YOLO (You Only Look Once)
"""

import numpy as np
import matplotlib.pyplot as plt
import cv2
import tensorflow as tf
from tensorflow.keras import layers, models
import warnings
warnings.filterwarnings('ignore')

print("="*60)
print("OBJECT DETECTION WITH YOLO")
print("="*60)

# 1. Introduction to YOLO
print("\n1. YOLO CONCEPT:")
print("""
YOLO (You Only Look Once) divides the image into a grid.
Each grid cell predicts:
- Bounding boxes (x, y, w, h)
- Confidence scores
- Class probabilities

Key advantages:
- Single forward pass
- Real-time detection
- Global context understanding
""")

# 2. Create a simple synthetic dataset for demonstration
print("\n2. CREATING SYNTHETIC OBJECT DETECTION DATA:")

def create_synthetic_image(size=416):
    """Create a synthetic image with random shapes"""
    img = np.ones((size, size, 3), dtype=np.uint8) * 255
    
    # Random circles (as objects)
    objects = []
    for _ in range(np.random.randint(1, 5)):
        center = (np.random.randint(50, size-50), np.random.randint(50, size-50))
        radius = np.random.randint(20, 50)
        color = tuple(np.random.randint(0, 255, 3).tolist())
        cv2.circle(img, center, radius, color, -1)
        
        # Store bounding box
        x1 = center[0] - radius
        y1 = center[1] - radius
        x2 = center[0] + radius
        y2 = center[1] + radius
        objects.append({
            'bbox': [x1, y1, x2, y2],
            'class': 0  # Assuming all are class 0 for simplicity
        })
    
    return img, objects

# Generate and display sample images
fig, axes = plt.subplots(2, 3, figsize=(15, 10))

for ax in axes.flat:
    img, objects = create_synthetic_image(300)
    ax.imshow(img)
    
    # Draw bounding boxes
    for obj in objects:
        x1, y1, x2, y2 = obj['bbox']
        rect = plt.Rectangle((x1, y1), x2-x1, y2-y1, 
                            fill=False, edgecolor='red', linewidth=2)
        ax.add_patch(rect)
    
    ax.set_title(f'Objects: {len(objects)}')
    ax.axis('off')

plt.suptitle('Synthetic Object Detection Data')
plt.tight_layout()
plt.savefig('synthetic_detection.png')
plt.show()
print("✅ Synthetic detection data saved as 'synthetic_detection.png'")

# 3. Simple YOLO-like model architecture
print("\n3. BUILDING A SIMPLE YOLO-LIKE MODEL:")

def create_simple_yolo(input_shape=(416, 416, 3), num_classes=1, grid_size=13):
    """Create a simplified YOLO-like model"""
    
    # Number of bounding boxes per cell
    num_boxes = 3
    
    # Output size: grid_size x grid_size x (num_boxes * (4 + 1) + num_classes)
    # 4: bbox coordinates, 1: confidence, num_classes: class probabilities
    
    model = models.Sequential([
        # Backbone (simplified)
        layers.Conv2D(32, (3, 3), activation='relu', padding='same', input_shape=input_shape),
        layers.MaxPooling2D((2, 2)),
        layers.Conv2D(64, (3, 3), activation='relu', padding='same'),
        layers.MaxPooling2D((2, 2)),
        layers.Conv2D(128, (3, 3), activation='relu', padding='same'),
        layers.MaxPooling2D((2, 2)),
        layers.Conv2D(256, (3, 3), activation='relu', padding='same'),
        layers.MaxPooling2D((2, 2)),
        
        # Detection layers
        layers.Conv2D(512, (3, 3), activation='relu', padding='same'),
        layers.Conv2D(1024, (3, 3), activation='relu', padding='same'),
        layers.Conv2D(num_boxes * (5 + num_classes), (1, 1), activation='linear')
    ])
    
    return model

yolo_model = create_simple_yolo()
