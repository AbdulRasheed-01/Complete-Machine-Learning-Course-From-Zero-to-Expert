        layers.MaxPooling2D((2, 2)),
        layers.Dropout(0.25),
        
        layers.Flatten(),
        layers.Dense(256, activation='relu'),
        layers.BatchNormalization(),
        layers.Dropout(0.5),
        layers.Dense(num_classes, activation='softmax')
    ])
    return model

models_dict['CNN Scratch'] = build_cnn_scratch()
print("CNN from scratch created")

# 5. Train all models
print("\n5. TRAINING ALL MODELS:")

results = {}
histories = {}

for name, model in models_dict.items():
    print(f"\n{'='*50}")
    print(f"Training {name}")
    print(f"{'='*50}")
    
    model.compile(
        optimizer=keras.optimizers.Adam(learning_rate=0.001),
        loss='categorical_crossentropy',
        metrics=['accuracy']
    )
    
    # Callbacks
    callbacks = [
        keras.callbacks.EarlyStopping(
            monitor='val_loss',
            patience=10,
            restore_best_weights=True
        ),
        keras.callbacks.ReduceLROnPlateau(
            monitor='val_loss',
            factor=0.5,
            patience=5,
            min_lr=1e-6
        )
    ]
    
    # Train
    history = model.fit(
        datagen.flow(X_train, y_train_cat, batch_size=32),
        steps_per_epoch=len(X_train) // 32,
        epochs=50,
        validation_data=(X_val, y_val_cat),
        callbacks=callbacks,
        verbose=1
    )
    
    histories[name] = history
    
    # Evaluate
    test_loss, test_acc = model.evaluate(X_test, y_test_cat, verbose=0)
    results[name] = test_acc
    print(f"\n{name} Test Accuracy: {test_acc:.4f}")

# 6. Compare results
print("\n6. COMPARING RESULTS:")

# Plot training histories
fig, axes = plt.subplots(2, 2, figsize=(14, 10))

for ax, (name, history) in zip(axes.flatten()[:len(models_dict)], histories.items()):
    ax.plot(history.history['accuracy'], label='Training', linewidth=2)
    ax.plot(history.history['val_accuracy'], label='Validation', linewidth=2)
    ax.set_title(f'{name} (Test Acc: {results[name]:.4f})')
    ax.set_xlabel('Epoch')
    ax.set_ylabel('Accuracy')
    ax.legend()
    ax.grid(True, alpha=0.3)

# Hide empty subplots
for i in range(len(models_dict), 4):
    axes.flatten()[i].set_visible(False)

plt.tight_layout()
plt.savefig('project_training_comparison.png')
plt.show()
print("✅ Training comparison saved as 'project_training_comparison.png'")

# Bar chart comparison
plt.figure(figsize=(10, 6))
bars = plt.bar(results.keys(), results.values(), edgecolor='black')
plt.ylabel('Test Accuracy')
plt.title('Model Comparison - Test Accuracy')
plt.ylim([0, 1])

# Add value labels
for bar, acc in zip(bars, results.values()):
    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.01,
             f'{acc:.4f}', ha='center', va='bottom')

plt.grid(True, alpha=0.3, axis='y')
plt.savefig('project_model_comparison.png')
plt.show()
print("✅ Model comparison saved as 'project_model_comparison.png'")

# 7. Best model evaluation
print("\n7. BEST MODEL EVALUATION:")

best_model_name = max(results, key=results.get)
best_model = models_dict[best_model_name]
best_accuracy = results[best_model_name]

print(f"Best model: {best_model_name}")
print(f"Best accuracy: {best_accuracy:.4f}")

# Confusion matrix for best model
y_pred = best_model.predict(X_test)
y_pred_classes = np.argmax(y_pred, axis=1)

cm = confusion_matrix(y_test, y_pred_classes)

plt.figure(figsize=(10, 8))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',
            xticklabels=class_names, yticklabels=class_names)
plt.xlabel('Predicted')
plt.ylabel('True')
plt.title(f'Confusion Matrix - {best_model_name}')
plt.savefig('project_confusion_matrix.png')
plt.show()
print("✅ Confusion matrix saved as 'project_confusion_matrix.png'")

# Classification report
print(f"\nClassification Report - {best_model_name}:")
print(classification_report(y_test, y_pred_classes, target_names=class_names))

# 8. Visualize predictions
print("\n8. VISUALIZING PREDICTIONS:")

n_samples = 16
sample_indices = np.random.choice(len(X_test), n_samples, replace=False)

fig, axes = plt.subplots(4, 4, figsize=(15, 15))

for ax, idx in zip(axes.flat, sample_indices):
    ax.imshow(X_test[idx])
    true_label = class_names[y_test[idx]]
    pred_label = class_names[y_pred_classes[idx]]
    confidence = np.max(y_pred[idx])
    
    color = 'green' if true_label == pred_label else 'red'
    ax.set_title(f'True: {true_label}\nPred: {pred_label} ({confidence:.2f})', color=color)
    ax.axis('off')

plt.suptitle(f'Predictions - {best_model_name}', fontsize=16, y=0.95)
plt.tight_layout()
plt.savefig('project_predictions.png')
plt.show()
print("✅ Predictions visualization saved as 'project_predictions.png'")

# 9. Error analysis
print("\n9. ERROR ANALYSIS:")

# Find misclassified examples
misclassified = np.where(y_pred_classes != y_test)[0]
print(f"Number of misclassified samples: {len(misclassified)}")
print(f"Error rate: {len(misclassified)/len(y_test)*100:.2f}%")

if len(misclassified) > 0:
    # Show some misclassifications
    n_mis = min(8, len(misclassified))
    fig, axes = plt.subplots(2, 4, figsize=(15, 8))
    
    for ax, idx in zip(axes.flat[:n_mis], misclassified[:n_mis]):
        ax.imshow(X_test[idx])
        true_label = class_names[y_test[idx]]
        pred_label = class_names[y_pred_classes[idx]]
        confidence = np.max(y_pred[idx])
        
        ax.set_title(f'True: {true_label}\nPred: {pred_label} ({confidence:.2f})', color='red')
        ax.axis('off')
    
    plt.suptitle('Misclassified Examples', fontsize=16)
    plt.tight_layout()
    plt.savefig('project_misclassified.png')
    plt.show()
    print("✅ Misclassified examples saved as 'project_misclassified.png'")

# 10. Save best model
print("\n10. SAVING BEST MODEL:")

best_model.save(f'best_model_{best_model_name}.h5')
print(f"✅ Best model saved as 'best_model_{best_model_name}.h5'")

# Convert to TensorFlow Lite
converter = tf.lite.TFLiteConverter.from_keras_model(best_model)
tflite_model = converter.convert()

with open('model.tflite', 'wb') as f:
    f.write(tflite_model)
print("✅ TensorFlow Lite model saved as 'model.tflite'")

