# 1. Implement convolution operation
print("\n1. CONVOLUTION OPERATION FROM SCRATCH:")

def conv2d_single(input_matrix, kernel, stride=1, padding=0):
    """
    Perform 2D convolution on a single channel
    """
    # Add padding
    if padding > 0:
        input_padded = np.pad(input_matrix, padding, mode='constant')
    else:
        input_padded = input_matrix
    
    h, w = input_padded.shape
    kh, kw = kernel.shape
    
    # Output dimensions
    out_h = (h - kh) // stride + 1
    out_w = (w - kw) // stride + 1
    
    output = np.zeros((out_h, out_w))
    
    # Perform convolution
    for i in range(0, out_h):
        for j in range(0, out_w):
            i_start = i * stride
            i_end = i_start + kh
            j_start = j * stride
            j_end = j_start + kw
            
            patch = input_padded[i_start:i_end, j_start:j_end]
            output[i, j] = np.sum(patch * kernel)
    
    return output

# Test convolution
