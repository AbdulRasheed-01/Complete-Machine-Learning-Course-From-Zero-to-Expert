# 4. Visualize convolution effects
print("\n4. VISUALIZING CONVOLUTION EFFECTS:")

# Create a simple image
image = np.zeros((50, 50))
image[20:30, 20:30] = 1  # White square

# Different kernels
kernels = {
    'Identity': np.array([[0, 0, 0], [0, 1, 0], [0, 0, 0]]),
    'Edge Detection': np.array([[-1, -1, -1], [-1, 8, -1], [-1, -1, -1]]),
    'Sharpen': np.array([[0, -1, 0], [-1, 5, -1], [0, -1, 0]]),
    'Gaussian Blur': np.array([[1, 2, 1], [2, 4, 2], [1, 2, 1]]) / 16,
    'Sobel X': np.array([[-1, 0, 1], [-2, 0, 2], [-1, 0, 1]]),
    'Sobel Y': np.array([[-1, -2, -1], [0, 0, 0], [1, 2, 1]])
}

fig, axes = plt.subplots(2, 3, figsize=(15, 10))

for ax, (name, kernel) in zip(axes.flatten(), kernels.items()):
    # Apply convolution
    convolved = conv2d_single(image, kernel)
    
    # Display
    ax.imshow(convolved, cmap='gray')
    ax.set_title(f'{name} Kernel')
    ax.axis('off')

plt.suptitle('Effect of Different Convolution Kernels')
plt.tight_layout()
plt.savefig('convolution_kernels.png')
plt.show()
print("✅ Convolution kernels visualization saved as 'convolution_kernels.png'")

