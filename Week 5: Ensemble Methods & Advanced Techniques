ax1.set_title('Model Comparison - RMSE (lower is better)')
ax1.grid(True, alpha=0.3, axis='x')

# R² Comparison
ax2 = axes[0, 1]
r2_values = comparison['R2'].values
bars = ax2.barh(models_names, r2_values, color=colors, edgecolor='black')
