print("✅ Stacking comparison saved as 'stacking_comparison.png'")

# 8. Cross-validation comparison
print("\n8. CROSS-VALIDATION COMPARISON:")

cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

