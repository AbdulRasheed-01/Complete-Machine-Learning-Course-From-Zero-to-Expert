                yticklabels=['Malignant', 'Benign'])
    ax.set_title(f'{name}\nAcc: {accuracy_score(y_test, y_pred):.4f}')
    ax.set_xlabel('Predicted')
    ax.set_ylabel('Actual')

plt.tight_layout()
plt.savefig('ensemble_confusion_matrices.png')
plt.show()
print("✅ Confusion matrices saved as 'ensemble_confusion_matrices.png'")
