# Plot training history
plt.figure(figsize=(10, 6))
epochs = len(evals_result['train']['logloss'])
x_axis = range(0, epochs)

plt.plot(x_axis, evals_result['train']['logloss'], label='Train LogLoss')
plt.plot(x_axis, evals_result['eval']['logloss'], label='Validation LogLoss')
plt.xlabel('Boosting Rounds')
plt.ylabel('LogLoss')
plt.title('XGBoost Training History')
plt.legend()
plt.grid(True, alpha=0.3)
plt.savefig('xgboost_training_history.png')
plt.show()
print("✅ Training history saved as 'xgboost_training_history.png'")
