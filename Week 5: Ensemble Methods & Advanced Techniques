    'XGBoost': xgb.XGBRegressor(n_estimators=100, learning_rate=0.1, random_state=42),
    'LightGBM': lgb.LGBMRegressor(n_estimators=100, learning_rate=0.1, random_state=42, verbose=-1),
    'CatBoost': CatBoostRegressor(iterations=100, learning_rate=0.1, verbose=0, random_seed=42)
}

# 5. Train and evaluate models
print("\n5. TRAINING AND EVALUATING MODELS:")

results = {}
predictions = {}
training_times = {}

for name, model in models.items():
    print(f"\n{name}:")
    
    # Train
    start_time = time.time()
    model.fit(X_train_scaled if name != 'CatBoost' else X_train, y_train)
    train_time = time.time() - start_time
    training_times[name] = train_time
    
    # Predict
    if name == 'CatBoost':
        y_pred = model.predict(X_test)
    else:
        y_pred = model.predict(X_test_scaled)
    
    # Calculate metrics
    mse = mean_squared_error(y_test, y_pred)
    rmse = np.sqrt(mse)
    mae = mean_absolute_error(y_test, y_pred)
    r2 = r2_score(y_test, y_pred)
    
    results[name] = {
        'MSE': mse,
        'RMSE': rmse,
        'MAE': mae,
        'R2': r2,
        'Time': train_time
    }
    
    predictions[name] = y_pred
    
    print(f"  RMSE: {rmse:.4f}")
    print(f"  MAE: {mae:.4f}")
    print(f"  R²: {r2:.4f}")
    print(f"  Training time: {train_time:.4f}s")

# 6. Stacking Regressor
print("\n6. STACKING REGRESSOR:")

# Base learners
base_learners = [
    ('rf', RandomForestRegressor(n_estimators=100, random_state=42)),
    ('gb', GradientBoostingRegressor(n_estimators=100, random_state=42)),
    ('xgb', xgb.XGBRegressor(n_estimators=100, random_state=42))
]

# Meta-learners to try
meta_learners = {
    'Ridge': Ridge(alpha=1.0),
    'Lasso': Lasso(alpha=0.001)
}

stacking_results = {}
for meta_name, meta_model in meta_learners.items():
    stacking = StackingRegressor(
        estimators=base_learners,
        final_estimator=meta_model,
        cv=5
    )
    
    start_time = time.time()
    stacking.fit(X_train_scaled, y_train)
    train_time = time.time() - start_time
    
    y_pred = stacking.predict(X_test_scaled)
    rmse = np.sqrt(mean_squared_error(y_test, y_pred))
    r2 = r2_score(y_test, y_pred)
    
    stacking_results[meta_name] = {
        'RMSE': rmse,
        'R2': r2,
        'Time': train_time
    }
    
    print(f"\nStacking with {meta_name}:")
    print(f"  RMSE: {rmse:.4f}")
    print(f"  R²: {r2:.4f}")
    print(f"  Training time: {train_time:.4f}s")

# 7. Performance Comparison
print("\n7. PERFORMANCE COMPARISON:")

# Create comparison DataFrame
comparison = pd.DataFrame(results).T
comparison = comparison.sort_values('RMSE')

print("\nModels ranked by RMSE:")
print(comparison[['RMSE', 'MAE', 'R2', 'Time']].round(4))

# Add stacking results
for meta_name, metrics in stacking_results.items():
    comparison.loc[f'Stacking ({meta_name})'] = [
        metrics['RMSE']**2, metrics['RMSE'], metrics['RMSE']*0.8,  # Approx MAE
        metrics['R2'], metrics['Time']
    ]

# 8. Visualize Results
print("\n8. VISUALIZING RESULTS:")

fig, axes = plt.subplots(2, 2, figsize=(14, 10))

# RMSE Comparison
ax1 = axes[0, 0]
models_names = comparison.index
rmse_values = comparison['RMSE'].values
colors = ['blue', 'green', 'orange', 'red', 'purple', 'brown', 'pink'][:len(models_names)]

bars = ax1.barh(models_names, rmse_values, color=colors, edgecolor='black')
