ax3.set_title('Model Comparison - Training Time')
ax3.grid(True, alpha=0.3, axis='x')

# Predictions vs Actual (best model)
best_model = comparison['RMSE'].idxmin()
ax4 = axes[1, 1]
y_pred_best = predictions.get(best_model, stacking_results.get(best_model.split()[-1], {}))
if isinstance(y_pred_best, dict):
    # Handle stacking predictions
    pass
else:
    ax4.scatter(y_test, y_pred_best, alpha=0.5, s=10)
    ax4.plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--', linewidth=2)
    ax4.set_xlabel('Actual Values')
    ax4.set_ylabel('Predicted Values')
    ax4.set_title(f'Best Model: {best_model}\nPredictions vs Actual')
    ax4.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('project_model_comparison.png')
plt.show()
print("✅ Model comparison saved as 'project_model_comparison.png'")

# 9. Feature Importance (from best tree-based model)
print("\n9. FEATURE IMPORTANCE:")

# Find best tree-based model
tree_models = ['Random Forest', 'Gradient Boosting', 'XGBoost', 'LightGBM']
available_tree_models = [m for m in tree_models if m in models]

for model_name in available_tree_models:
    model = models[model_name]
    if hasattr(model, 'feature_importances_'):
        importance = model.feature_importances_
        
        plt.figure(figsize=(10, 6))
        indices = np.argsort(importance)[::-1]
        plt.barh(range(len(feature_names)), importance[indices][::-1])
