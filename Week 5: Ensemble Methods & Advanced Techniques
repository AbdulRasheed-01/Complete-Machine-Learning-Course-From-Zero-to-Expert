        print(f"✅ {model_name} importance saved")
        break

# 10. Residual Analysis
print("\n10. RESIDUAL ANALYSIS:")

# Use best model for residual analysis
best_model_name = comparison['RMSE'].idxmin()
if best_model_name in models:
    best_model = models[best_model_name]
    if best_model_name == 'CatBoost':
        y_pred_best = best_model.predict(X_test)
    else:
        y_pred_best = best_model.predict(X_test_scaled)
    
    residuals = y_test - y_pred_best
    
    fig, axes = plt.subplots(1, 2, figsize=(14, 5))
    
    # Residuals vs Predicted
    axes[0].scatter(y_pred_best, residuals, alpha=0.5, s=10)
    axes[0].axhline(y=0, color='r', linestyle='--', linewidth=2)
    axes[0].set_xlabel('Predicted Values')
    axes[0].set_ylabel('Residuals')
    axes[0].set_title(f'Residual Plot - {best_model_name}')
    axes[0].grid(True, alpha=0.3)
    
    # Histogram of residuals
    axes[1].hist(residuals, bins=50, edgecolor='black', alpha=0.7)
    axes[1].axvline(x=0, color='r', linestyle='--', linewidth=2)
    axes[1].set_xlabel('Residuals')
    axes[1].set_ylabel('Frequency')
    axes[1].set_title('Residual Distribution')
    axes[1].grid(True, alpha=0.3, axis='y')
    
    plt.tight_layout()
    plt.savefig('project_residuals.png')
    plt.show()
    print("✅ Residual analysis saved as 'project_residuals.png'")

# 11. Hyperparameter Tuning for Best Model
print("\n11. HYPERPARAMETER TUNING FOR BEST MODEL:")

if best_model_name in models:
    print(f"Tuning {best_model_name}...")
    
    if best_model_name == 'XGBoost':
        param_grid = {
            'n_estimators': [100, 200],
            'max_depth': [3, 6, 9],
            'learning_rate': [0.01, 0.1, 0.3]
        }
        model_to_tune = xgb.XGBRegressor(random_state=42)
        
    elif best_model_name == 'LightGBM':
        param_grid = {
            'n_estimators': [100, 200],
            'max_depth': [5, 10, -1],
            'learning_rate': [0.05, 0.1, 0.2]
        }
        model_to_tune = lgb.LGBMRegressor(random_state=42, verbose=-1)
        
    elif best_model_name == 'Random Forest':
        param_grid = {
            'n_estimators': [100, 200],
            'max_depth': [10, 20, None],
            'min_samples_split': [2, 5, 10]
        }
        model_to_tune = RandomForestRegressor(random_state=42)
        
    else:
        param_grid = {}
        model_to_tune = None
    
    if model_to_tune and param_grid:
        # Use smaller grid for speed
        simple_grid = {k: v[:2] for k, v in param_grid.items()}
        
        grid_search = GridSearchCV(
            model_to_tune,
            simple_grid,
            cv=3,
            scoring='neg_mean_squared_error',
            n_jobs=-1,
            verbose=1
        )
        
        grid_search.fit(X_train_scaled, y_train)
        
        print(f"\nBest parameters: {grid_search.best_params_}")
        print(f"Best CV score (-RMSE): {np.sqrt(-grid_search.best_score_):.4f}")
        
        # Evaluate tuned model
        y_pred_tuned = grid_search.predict(X_test_scaled)
        rmse_tuned = np.sqrt(mean_squared_error(y_test, y_pred_tuned))
        print(f"Test RMSE with tuned model: {rmse_tuned:.4f}")
        print(f"Improvement: {comparison.loc[best_model_name, 'RMSE'] - rmse_tuned:.4f}")

