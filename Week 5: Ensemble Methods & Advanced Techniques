print(f"CatBoost is {sklearn_time/train_time:.2f}x faster")

# 7. Cross-validation
print("\n7. CROSS-VALIDATION:")

# Use Pool for efficient cross-validation
train_pool = Pool(X_train, y_train, cat_features=cat_features_indices)

cv_data = cv(
