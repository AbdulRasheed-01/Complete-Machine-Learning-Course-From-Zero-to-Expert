print(f"Stacking CV: {stacking_cv_scores.mean():.4f} (+/- {stacking_cv_scores.std():.4f})")

# 9. Confusion Matrices
print("\n9. CONFUSION MATRICES:")

fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# Best base model
y_pred_base = best_base_model.predict(X_test)
