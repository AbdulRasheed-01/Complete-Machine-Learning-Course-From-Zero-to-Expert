# 3. K-Means with scikit-learn
print("\n3. K-MEANS WITH SCIKIT-LEARN:")

kmeans_sk = KMeans(n_clusters=4, random_state=42, n_init=10)
kmeans_sk.fit(X)
y_pred_sk = kmeans_sk.predict(X)

print(f"scikit-learn K-Means inertia: {kmeans_sk.inertia_:.2f}")
print(f"Number of iterations: {kmeans_sk.n_iter_}")

# Compare results
ari_score = adjusted_rand_score(y_true, y_pred_sk)
print(f"Adjusted Rand Index vs true labels: {ari_score:.4f}")

