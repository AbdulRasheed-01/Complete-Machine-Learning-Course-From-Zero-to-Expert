# 6. Finding optimal epsilon with k-distance graph
print("\n6. K-DISTANCE GRAPH FOR EPSILON SELECTION:")

from sklearn.neighbors import NearestNeighbors

def plot_k_distance(X, k=5):
    """Plot k-distance graph to find optimal epsilon"""
    neighbors = NearestNeighbors(n_neighbors=k)
    neighbors_fit = neighbors.fit(X)
    distances, indices = neighbors_fit.kneighbors(X)
    
    # Sort distances
    k_dist = np.sort(distances[:, k-1])
    
    plt.figure(figsize=(10, 6))
    plt.plot(k_dist)
    plt.xlabel('Points sorted by distance')
    plt.ylabel(f'{k}-th neighbor distance')
    plt.title(f'K-Distance Graph (k={k}) - Find the "elbow"')
    plt.grid(True, alpha=0.3)
    
    # Find the elbow (approximate)
    # The optimal eps is at the point of maximum curvature
    return plt.gcf()

fig = plot_k_distance(X_scaled, k=5)
plt.savefig('dbscan_k_distance.png')
plt.show()
print("✅ K-distance graph saved as 'dbscan_k_distance.png'")

