"""
DBSCAN - Density-Based Spatial Clustering of Applications with Noise
"""

import numpy as np
import matplotlib.pyplot as plt
from sklearn.cluster import DBSCAN
from sklearn.datasets import make_moons, make_circles, make_blobs
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import silhouette_score
import warnings
warnings.filterwarnings('ignore')

print("="*60)
print("DBSCAN CLUSTERING")
print("="*60)

# 1. Generate datasets with different shapes
print("\n1. GENERATING DATASETS:")

np.random.seed(42)
n_samples = 300

# Moons dataset
X_moons, y_moons = make_moons(n_samples=n_samples, noise=0.05, random_state=42)

# Circles dataset
X_circles, y_circles = make_circles(n_samples=n_samples, noise=0.05, factor=0.5, random_state=42)

# Blobs dataset
X_blobs, y_blobs = make_blobs(n_samples=n_samples, centers=3, cluster_std=1.0, random_state=42)

# Add some noise
X_noise = np.random.randn(50, 2) * 3
X_blobs_noise = np.vstack([X_blobs, X_noise])
y_blobs_noise = np.hstack([y_blobs, [-1] * 50])  # -1 for noise

datasets = [
    ('Moons', X_moons, y_moons),
    ('Circles', X_circles, y_circles),
    ('Blobs with Noise', X_blobs_noise, y_blobs_noise)
]

fig, axes = plt.subplots(1, 3, figsize=(15, 5))

for ax, (name, X, y) in zip(axes, datasets):
    ax.scatter(X[:, 0], X[:, 1], c=y, cmap='viridis', edgecolors='black', alpha=0.7)
    ax.set_title(name)
    ax.set_xlabel('Feature 1')
    ax.set_ylabel('Feature 2')
    ax.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('dbscan_datasets.png')
plt.show()
print("✅ Datasets visualization saved as 'dbscan_datasets.png'")

# 2. DBSCAN parameters exploration
print("\n2. DBSCAN PARAMETERS:")

# Use moons dataset for parameter exploration
X = X_moons
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Try different epsilon values
eps_values = [0.1, 0.2, 0.3, 0.4]
fig, axes = plt.subplots(2, 2, figsize=(12, 10))

for ax, eps in zip(axes.flatten(), eps_values):
    dbscan = DBSCAN(eps=eps, min_samples=5)
    labels = dbscan.fit_predict(X_scaled)
    
    n_clusters = len(set(labels)) - (1 if -1 in labels else 0)
    n_noise = list(labels).count(-1)
    
    ax.scatter(X_scaled[:, 0], X_scaled[:, 1], c=labels, cmap='viridis', edgecolors='black', alpha=0.7)
    ax.set_title(f'eps={eps}, clusters={n_clusters}, noise={n_noise}')
    ax.set_xlabel('Feature 1 (scaled)')
    ax.set_ylabel('Feature 2 (scaled)')
    ax.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('dbscan_eps_comparison.png')
plt.show()
print("✅ Epsilon comparison saved as 'dbscan_eps_comparison.png'")

# 3. Try different min_samples values
print("\n3. MIN_SAMPLES PARAMETER:")

min_samples_values = [3, 5, 10, 20]
fig, axes = plt.subplots(2, 2, figsize=(12, 10))

for ax, min_samples in zip(axes.flatten(), min_samples_values):
    dbscan = DBSCAN(eps=0.3, min_samples=min_samples)
    labels = dbscan.fit_predict(X_scaled)
    
    n_clusters = len(set(labels)) - (1 if -1 in labels else 0)
    n_noise = list(labels).count(-1)
    
    ax.scatter(X_scaled[:, 0], X_scaled[:, 1], c=labels, cmap='viridis', edgecolors='black', alpha=0.7)
    ax.set_title(f'min_samples={min_samples}, clusters={n_clusters}, noise={n_noise}')
    ax.set_xlabel('Feature 1 (scaled)')
    ax.set_ylabel('Feature 2 (scaled)')
    ax.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('dbscan_min_samples_comparison.png')
plt.show()
print("✅ Min samples comparison saved as 'dbscan_min_samples_comparison.png'")

# 4. DBSCAN on all datasets
print("\n4. DBSCAN ON DIFFERENT DATASETS:")

fig, axes = plt.subplots(2, 3, figsize=(15, 10))

# Original data
for ax, (name, X, y) in zip(axes[0], datasets):
    ax.scatter(X[:, 0], X[:, 1], c=y, cmap='viridis', edgecolors='black', alpha=0.7)
