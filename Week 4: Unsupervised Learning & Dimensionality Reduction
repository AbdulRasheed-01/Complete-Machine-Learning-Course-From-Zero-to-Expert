print("\n3. DATA PREPROCESSING:")

# Select features for clustering
features_for_clustering = ['age', 'annual_income', 'spending_score', 'membership_years',
                           'purchase_frequency', 'avg_transaction_value', 'returns_rate',
                           'online_orders_pct', 'days_since_last_purchase']

X = df[features_for_clustering].copy()
print(f"Feature matrix shape: {X.shape}")
